          "name": "Create an upload",
          "request": {
            "name": "Create an upload",
            "description": {
              "content": "Request a pre-signed URL to upload an image asset. Upload the file with an HTTP `PUT` to the returned `presignedUrl` (sending the same `Content-Type` and `Content-Length`), then call `/uploads/{id}/complete` to finalize the asset.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "uploads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
